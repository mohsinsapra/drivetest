# Load root project .env so credentials live in one place
require "base64"

root_env = File.expand_path("../../.env", __dir__)
if File.exist?(root_env)
  File.foreach(root_env) do |line|
    line.strip!
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    ENV[key] ||= value if key && value
  end
end

default_platform(:ios)

platform :ios do
  desc "Build IPA only (no upload)"
  lane :build do
    ENV['BUILD_VARIANT'] ||= 'testflight'
    get_provisioning_profile(
      app_identifier: "com.mohsinsapra.drivetest",
      team_id: "MBWC2B7V68"
    )
    ipa_path = build_ios_archive
    UI.success("✅ IPA ready: #{ipa_path}")
    tag_release
  end

  desc "Upload last built IPA to TestFlight"
  lane :upload do
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    if ipa_path.to_s.strip.empty? || !File.exist?(ipa_path)
      fallback_ipa_path = File.expand_path("../Runner.ipa", __dir__)
      ipa_path = fallback_ipa_path if File.exist?(fallback_ipa_path)
    end
    UI.user_error!("No IPA found at #{ipa_path} — run `fastlane build` first") unless File.exist?(ipa_path)

    app_password = ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
    UI.user_error!("Set FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD in ios/fastlane/.env") if app_password.nil? || app_password.empty? || app_password == "your-app-specific-password-here"

    sh("xcrun altool --upload-app " \
       "-f '#{ipa_path}' " \
       "-t ios " \
       "-u mohsin.sapra@gmail.com " \
       "-p '#{app_password}' " \
       "--asc-provider 128337297 " \
       "--output-format normal")
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    ENV['BUILD_VARIANT'] = 'testflight'
    build
    upload
  end

  desc "Deploy to both iOS TestFlight and Android Play Store alpha"
  lane :deploy_all do
    UI.message("🍎 Starting iOS build & upload...")
    beta

    UI.message("🤖 Starting Android build & upload...")
    sh("cd ../../android && bundle exec fastlane beta")

    UI.success("✅ Deployed to both iOS TestFlight and Android Play Store!")
  end

  desc "Deploy Production"
  lane :production do
    ENV['BUILD_VARIANT'] = 'production'
    # Update version
    update_flutter_version

    # Get changelog
    changelog_text = get_latest_changelog_entry

    ipa_path = build_ios_archive(export_options: "ExportOptions.plist")
    upload_to_app_store(
      ipa: ipa_path,
      release_notes: {
        "en-US" => changelog_text
      }
    )

    # Tag the release
    tag_release
  end

  # Helper methods
  private_lane :update_flutter_version do
    # Read current version from pubspec.yaml
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    current_version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if current_version_match
      version = current_version_match[1]
      build = current_version_match[2].to_i

      # Increment build number
      new_build = build + 1

      # Update pubspec.yaml
      updated_content = pubspec_content.gsub(
        /^version:\s*.+/,
        "version: #{version}+#{new_build}"
      )
      File.write(pubspec_path, updated_content)

      puts "📦 Updated version: #{version}+#{new_build}"

      # Update iOS version and build number
      increment_version_number(version_number: version)
      increment_build_number(build_number: new_build)
    end
  end

  private_lane :get_latest_changelog_entry do
    changelog_path = "../../CHANGELOG.md"
    changelog_text = ""

    if File.exist?(changelog_path)
      changelog_content = File.read(changelog_path)

      # Extract the latest version entry (after Unreleased section)
      match = changelog_content.match(/## \[\d+\.\d+\.\d+\+\d+\].*?\n\n(.*?)(?=\n---|\z)/m)

      if match
        # Clean up the changelog text
        changelog_text = match[1]
          .gsub(/^### /, '')  # Remove heading markers
          .gsub(/^- /, '• ')  # Convert markdown lists to bullets
          .strip
      end
    end

    # Fallback to commit message if no changelog found
    if changelog_text.empty?
      changelog_text = sh("git log -1 --pretty=%B").strip
    end

    changelog_text
  end

  private_lane :tag_release do
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if version_match
      version_tag = "v#{version_match[1]}-#{version_match[2]}"

      begin
        sh("git tag #{version_tag}")
        puts "✅ Created tag: #{version_tag}"
        puts "   Push it with: git push origin #{version_tag}"
      rescue => e
        puts "⚠️  Failed to create tag (may already exist): #{e.message}"
      end
    end
  end

  private_lane :build_ios_archive do |options|
    options ||= {}
    build_options = {
      scheme: "Runner",
      xcargs: "DART_DEFINES=#{resolve_xcode_dart_defines}"
    }

    if options[:export_options]
      build_options[:export_options] = options[:export_options]
    else
      build_options[:export_method] = "app-store"
      build_options[:export_options] = {
        method: "app-store",
        teamID: "MBWC2B7V68",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.mohsinsapra.drivetest" => ENV["SIGH_NAME"]
        }
      }
    end

    build_app(**build_options)
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fastlane did not produce an IPA path") if ipa_path.to_s.strip.empty?

    ipa_path
  end

  private_lane :resolve_flutter_dart_defines do
    explicit_defines = ENV["FLUTTER_DART_DEFINES"].to_s.strip
    return explicit_defines unless explicit_defines.empty?

    env_vars = load_root_env
    google_server_client_id = env_vars["GOOGLE_SERVER_CLIENT_ID"].to_s.strip
    stripe_publishable_key = env_vars["STRIPE_PUBLISHABLE_KEY"].to_s.strip
    field_encryption_key = env_vars["FIELD_ENCRYPTION_KEY"].to_s.strip

    defines = []
    defines << "--dart-define=GOOGLE_SERVER_CLIENT_ID=#{google_server_client_id}" unless google_server_client_id.empty?
    defines << "--dart-define=STRIPE_PUBLISHABLE_KEY=#{stripe_publishable_key}" unless stripe_publishable_key.empty?
    defines << "--dart-define=FIELD_ENCRYPTION_KEY=#{field_encryption_key}" unless field_encryption_key.empty?

    defines.join(" ")
  end

  private_lane :resolve_xcode_dart_defines do
    env_vars = load_root_env
    explicit_defines = ENV["FLUTTER_DART_DEFINES"].to_s.strip

    build_variant = ENV["BUILD_VARIANT"].to_s.strip
    build_variant = "debug" if build_variant.empty?

    define_entries =
      if explicit_defines.empty?
        entries = []
        google_server_client_id = env_vars["GOOGLE_SERVER_CLIENT_ID"].to_s.strip
        stripe_publishable_key = env_vars["STRIPE_PUBLISHABLE_KEY"].to_s.strip

        entries << "GOOGLE_SERVER_CLIENT_ID=#{google_server_client_id}" unless google_server_client_id.empty?
        entries << "STRIPE_PUBLISHABLE_KEY=#{stripe_publishable_key}" unless stripe_publishable_key.empty?
        entries << "BUILD_VARIANT=#{build_variant}"
        entries
      else
        # Inject BUILD_VARIANT unless the caller already specified it
        all_entries = explicit_defines.split(/\s+/).filter_map do |arg|
          next unless arg.start_with?("--dart-define=")
          arg.delete_prefix("--dart-define=")
        end
        all_entries << "BUILD_VARIANT=#{build_variant}" unless all_entries.any? { |e| e.start_with?("BUILD_VARIANT=") }
        all_entries
      end

    define_entries.map { |entry| Base64.strict_encode64(entry) }.join(",")
  end

  private_lane :load_root_env do
    env_path = File.expand_path("../../.env", __dir__)
    return {} unless File.exist?(env_path)

    File.readlines(env_path).each_with_object({}) do |line, vars|
      next if line.strip.empty? || line.lstrip.start_with?("#")

      key, value = line.split("=", 2)
      next if key.nil? || value.nil?

      vars[key.strip] = value.strip
    end
  end
end
