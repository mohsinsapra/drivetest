# Load root project .env so credentials live in one place
require "base64"

root_env = File.expand_path("../../.env", __dir__)
if File.exist?(root_env)
  File.foreach(root_env) do |line|
    line.strip!
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    ENV[key] ||= value if key && value
  end
end

default_platform(:ios)

platform :ios do
  desc "Build IPA only (no upload)"
  lane :build do
    ENV['BUILD_VARIANT'] ||= 'testflight'
    get_provisioning_profile(
      app_identifier: "com.mohsinsapra.drivetest",
      team_id: "MBWC2B7V68"
    )
    ipa_path = build_ios_archive
    UI.success("✅ IPA ready: #{ipa_path}")
    tag_release
  end

  desc "Upload last built IPA to TestFlight"
  lane :upload do
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    if ipa_path.to_s.strip.empty? || !File.exist?(ipa_path)
      fallback_ipa_path = File.expand_path("../Runner.ipa", __dir__)
      ipa_path = fallback_ipa_path if File.exist?(fallback_ipa_path)
    end
    UI.user_error!("No IPA found at #{ipa_path} — run `fastlane build` first") unless File.exist?(ipa_path)

    using_api_key = setup_asc_api_key
    # App-specific password is only needed for the legacy (no API key) auth path.
    unless using_api_key
      app_password = ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
      UI.user_error!("Set an App Store Connect API key (ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_PATH) or FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD in the root .env") if app_password.nil? || app_password.empty? || app_password == "your-app-specific-password-here"
    end

    changelog = get_latest_changelog_entry

    upload_to_testflight(
      ipa: ipa_path,
      username: using_api_key ? nil : "mohsin.sapra@gmail.com",
      team_id: "128337297",
      changelog: changelog,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    ENV['BUILD_VARIANT'] = 'testflight'
    build
    upload
  end

  desc "Deploy to both iOS TestFlight and Android Play Store alpha"
  lane :deploy_all do
    UI.message("🍎 Starting iOS build & upload...")
    beta

    UI.message("🤖 Starting Android build & upload...")
    sh("cd ../../android && bundle exec fastlane beta")

    UI.success("✅ Deployed to both iOS TestFlight and Android Play Store!")
  end

  desc "Deploy Production (fresh build → App Store, fully hands-off)"
  lane :production do
    ENV['BUILD_VARIANT'] = 'production'
    setup_asc_api_key

    # Update version (skipped when the caller — e.g. `make ios-deploy` — already
    # bumped + committed the version, so the bump has a single source of truth)
    update_flutter_version unless ENV["SKIP_FLUTTER_VERSION_BUMP"] == "1"

    # Get changelog
    changelog_text = get_latest_changelog_entry

    ipa_path = build_ios_archive(export_options: "ExportOptions.plist")
    upload_to_app_store(
      ipa: ipa_path,
      release_notes: localized_release_notes(text: changelog_text),
      screenshots_path: "fastlane/screenshots",
      skip_screenshots: false,
      # ── Hands-off submission ──────────────────────────────────────────────
      submit_for_review: true,   # actually send to Apple review (not just upload)
      force: true,               # skip the HTML preview confirmation prompt
      automatic_release: true,   # auto-release once Apple approves
      submission_information: {
        add_id_info_uses_idfa: false # app does not use the advertising identifier
      }
    )

    # Tag the release
    tag_release

    # Notify backend that a new production build is live
    notify_app_update
  end

  desc "Promote the latest TestFlight build to App Store production (no rebuild)"
  lane :promote do
    setup_asc_api_key

    changelog_text = get_latest_changelog_entry

    pubspec_content = File.read(File.expand_path("../../pubspec.yaml", __dir__))
    version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    UI.user_error!("Could not read version from pubspec.yaml") unless version_match
    app_version  = version_match[1].strip
    build_number = version_match[2].strip

    UI.message("🚀 Promoting build #{app_version} (#{build_number}) from TestFlight to production…")

    upload_to_app_store(
      app_identifier: "com.mohsinsapra.drivetest",
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,  # reuse the exact build already on TestFlight
      release_notes: localized_release_notes(text: changelog_text),
      # Promote reuses the existing build + listing; screenshots already live on
      # the App Store version and carry over, so don't re-upload them.
      skip_screenshots: true,
      submit_for_review: true,
      force: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    notify_app_update
  end

  # Helper methods

  # Loads an App Store Connect API key (.p8) if configured in the root .env.
  # Returns true when the key was set (all later upload/submit actions pick it
  # up automatically). Falls back to Apple ID + app-specific password otherwise.
  #
  # The API key is the reliable path for unattended runs: unlike a
  # FASTLANE_SESSION it does not expire, so "deploy to TestFlight now, run
  # production weeks later" works without re-authenticating.
  private_lane :setup_asc_api_key do
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    key_path = ENV["ASC_KEY_PATH"].to_s.strip

    if !key_id.empty? && !issuer_id.empty? && !key_path.empty? && File.exist?(key_path)
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_path,
        duration: 1200,
        in_house: false
      )
      UI.success("🔑 Using App Store Connect API key for authentication")
      true
    else
      UI.important("⚠️  No App Store Connect API key found — falling back to Apple ID + app-specific password.")
      UI.important("    Hands-off submission can fail when the login session expires. To make it reliable, set")
      UI.important("    ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH in the root .env (see .env.example).")
      false
    end
  end

  # This app's App Store locales are en-GB + sv (NOT en-US). deliver must update
  # the EXISTING localizations; passing a locale the version doesn't have (e.g.
  # en-US) makes deliver create one, which re-runs Apple's global app-name
  # uniqueness check and fails with "app name is already being used".
  # Swedish notes come from WHATS_NEW_SV when set, else fall back to English.
  private_lane :localized_release_notes do |options|
    english = options[:text].to_s
    swedish = ENV["WHATS_NEW_SV"].to_s.strip
    swedish = english if swedish.empty?
    {
      "en-GB" => english,
      "sv" => swedish
    }
  end

  private_lane :update_flutter_version do
    # Read current version from pubspec.yaml
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    current_version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if current_version_match
      version = current_version_match[1]
      build = current_version_match[2].to_i

      # Increment build number
      new_build = build + 1

      # Update pubspec.yaml
      updated_content = pubspec_content.gsub(
        /^version:\s*.+/,
        "version: #{version}+#{new_build}"
      )
      File.write(pubspec_path, updated_content)

      puts "📦 Updated version: #{version}+#{new_build}"

      # Update iOS version and build number
      increment_version_number(version_number: version)
      increment_build_number(build_number: new_build)
    end
  end

  private_lane :get_latest_changelog_entry do
    changelog_path = "../../CHANGELOG.md"
    changelog_text = ""

    if File.exist?(changelog_path)
      changelog_content = File.read(changelog_path)

      # Extract the first versioned release body (skips [Unreleased])
      match = changelog_content.match(/## \[\d+\.\d+\.\d+\+\d+\][^\n]*\n(.*?)(?=\n## |\z)/m)

      if match
        body = match[1]
        sections = []

        ["Added", "Changed", "Fixed"].each do |section|
          sec_match = body.match(/### #{section}\n(.*?)(?=\n### |\n---|\z)/m)
          next unless sec_match

          bullets = sec_match[1]
            .split("\n")
            .map(&:strip)
            .select { |line| line.match?(/^-\s+\S/) }
            .map do |line|
              text = line.sub(/^-\s+/, "")
              # Strip markdown: **bold**, *italic*, _italic_, `code`, [text](url)
              text = text.gsub(/\*\*(.+?)\*\*/, '\1')
              text = text.gsub(/\*(.+?)\*/, '\1')
              text = text.gsub(/_(.+?)_/, '\1')
              text = text.gsub(/`(.+?)`/, '\1')
              text = text.gsub(/\[([^\]]+)\]\([^)]+\)/, '\1')
              "- #{text.strip}"
            end

          next if bullets.empty?

          sections << "#{section}:\n#{bullets.join("\n")}"
        end

        changelog_text = sections.join("\n\n").strip
      end
    end

    # Fallback to commit message if no changelog found
    if changelog_text.empty?
      changelog_text = sh("git log -1 --pretty=%B").strip
    end

    # TestFlight limit: 4000 characters
    if changelog_text.length > 4000
      changelog_text = changelog_text[0...3997] + "..."
    end

    changelog_text
  end

  private_lane :tag_release do
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if version_match
      version_tag = "v#{version_match[1]}-#{version_match[2]}"

      begin
        sh("git tag #{version_tag}")
        puts "✅ Created tag: #{version_tag}"
        puts "   Push it with: git push origin #{version_tag}"
      rescue => e
        puts "⚠️  Failed to create tag (may already exist): #{e.message}"
      end
    end
  end

  private_lane :build_ios_archive do |options|
    options ||= {}

    pubspec_content = File.read(File.expand_path("../../pubspec.yaml", __dir__))
    version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    build_name   = version_match ? version_match[1].strip : ""
    build_number = version_match ? version_match[2].strip : ""

    xcargs = "DART_DEFINES=#{resolve_xcode_dart_defines} FLUTTER_BUILD_NAME=#{build_name} FLUTTER_BUILD_NUMBER=#{build_number}"

    # Let xcodebuild regenerate stale Xcode-managed dev profiles (e.g. after a
    # certificate is recreated) using the ASC API key instead of failing.
    asc_key_id = ENV["ASC_KEY_ID"].to_s.strip
    asc_issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    asc_key_path = ENV["ASC_KEY_PATH"].to_s.strip
    if !asc_key_id.empty? && !asc_issuer_id.empty? && File.exist?(asc_key_path)
      xcargs += " -allowProvisioningUpdates -authenticationKeyPath #{File.expand_path(asc_key_path)} -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}"
    end

    build_options = {
      scheme: "Runner",
      xcargs: xcargs
    }

    if options[:export_options]
      build_options[:export_options] = options[:export_options]
    else
      build_options[:export_method] = "app-store"
      build_options[:export_options] = {
        method: "app-store",
        teamID: "MBWC2B7V68",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.mohsinsapra.drivetest" => ENV["SIGH_NAME"]
        }
      }
    end

    build_app(**build_options)
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fastlane did not produce an IPA path") if ipa_path.to_s.strip.empty?

    ipa_path
  end

  private_lane :resolve_flutter_dart_defines do
    explicit_defines = ENV["FLUTTER_DART_DEFINES"].to_s.strip
    return explicit_defines unless explicit_defines.empty?

    env_vars = load_root_env
    google_server_client_id = env_vars["GOOGLE_SERVER_CLIENT_ID"].to_s.strip
    stripe_publishable_key = env_vars["STRIPE_PUBLISHABLE_KEY"].to_s.strip
    field_encryption_key = env_vars["FIELD_ENCRYPTION_KEY"].to_s.strip

    defines = []
    defines << "--dart-define=GOOGLE_SERVER_CLIENT_ID=#{google_server_client_id}" unless google_server_client_id.empty?
    defines << "--dart-define=STRIPE_PUBLISHABLE_KEY=#{stripe_publishable_key}" unless stripe_publishable_key.empty?
    defines << "--dart-define=FIELD_ENCRYPTION_KEY=#{field_encryption_key}" unless field_encryption_key.empty?

    defines.join(" ")
  end

  private_lane :resolve_xcode_dart_defines do
    env_vars = load_root_env
    explicit_defines = ENV["FLUTTER_DART_DEFINES"].to_s.strip

    build_variant = ENV["BUILD_VARIANT"].to_s.strip
    build_variant = "debug" if build_variant.empty?

    define_entries =
      if explicit_defines.empty?
        entries = []
        google_server_client_id = env_vars["GOOGLE_SERVER_CLIENT_ID"].to_s.strip
        stripe_publishable_key = env_vars["STRIPE_PUBLISHABLE_KEY"].to_s.strip
        field_encryption_key = env_vars["FIELD_ENCRYPTION_KEY"].to_s.strip
        gemini_api_key = env_vars["GEMINI_API_KEY"].to_s.strip

        entries << "GOOGLE_SERVER_CLIENT_ID=#{google_server_client_id}" unless google_server_client_id.empty?
        entries << "STRIPE_PUBLISHABLE_KEY=#{stripe_publishable_key}" unless stripe_publishable_key.empty?
        entries << "FIELD_ENCRYPTION_KEY=#{field_encryption_key}" unless field_encryption_key.empty?
        entries << "GEMINI_API_KEY=#{gemini_api_key}" unless gemini_api_key.empty?
        entries << "BUILD_VARIANT=#{build_variant}"
        entries
      else
        # Inject BUILD_VARIANT unless the caller already specified it
        all_entries = explicit_defines.split(/\s+/).filter_map do |arg|
          next unless arg.start_with?("--dart-define=")
          arg.delete_prefix("--dart-define=")
        end
        all_entries << "BUILD_VARIANT=#{build_variant}" unless all_entries.any? { |e| e.start_with?("BUILD_VARIANT=") }
        all_entries
      end

    define_entries.map { |entry| Base64.strict_encode64(entry) }.join(",")
  end

  private_lane :load_root_env do
    env_path = File.expand_path("../../.env", __dir__)
    return {} unless File.exist?(env_path)

    File.readlines(env_path).each_with_object({}) do |line, vars|
      next if line.strip.empty? || line.lstrip.start_with?("#")

      key, value = line.split("=", 2)
      next if key.nil? || value.nil?

      vars[key.strip] = value.strip
    end
  end

  private_lane :notify_app_update do
    require "net/http"
    require "uri"

    backend_url = ENV["BACKEND_URL"].to_s.strip
    UI.user_error!("Set BACKEND_URL in the root .env") if backend_url.empty?

    api_key = ENV["NOTIFY_API_KEY"].to_s.strip
    UI.user_error!("Set NOTIFY_API_KEY in the root .env") if api_key.empty?

    uri = URI("#{backend_url}/api/v2/notify-update/")
    req = Net::HTTP::Post.new(uri)
    req["X-Api-Key"] = api_key
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https") { |h| h.request(req) }
    UI.user_error!("notify-update failed: HTTP #{res.code}") unless res.is_a?(Net::HTTPSuccess)
    UI.success("App update push notification sent.")
  end
end
