# ====================================================================
# PROJECT-SPECIFIC IGNORES (Adjust as needed)
# ====================================================================

# Environment variables
.env
.env.*
!.env.example # Keep example files for team collaboration

# Generated Fastlane files (if applicable)
# These are often generated by Fastlane or CI/CD tools
fastlane/.env
fastlane/report.xml
fastlane/screenshots/
fastlane/test_output/

# ====================================================================
# GENERAL IGNORES (Cross-Platform)
# ====================================================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
Thumbs.db # Windows thumbnail cache

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
!.idea/runConfigurations # Keep run configurations if shared within team

# VS Code related (Uncomment if you want to ignore VS Code settings)
# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-workspace

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
*.packages # Old pub dependency file (mostly superseded by .dart_tool/package_config.json)
.flutter-plugins-dependencies # Often generated for plugin discovery
.flutter_tool_state

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# ====================================================================
# PLATFORM-SPECIFIC IGNORES
# ====================================================================

# Android specific
/android/.gradle
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/build/
/android/.idea/
/android/*.iml
/android/local.properties # Contains SDK paths, user specific
/android/.cxx/
/android/captures/
/android/gradle-wrapper/gradle-wrapper.jar # Usually comes with project template, but can be ignored if using a global Gradle distribution
/android/gradlew
/android/gradlew.bat
/android/gradle/wrapper/gradle-wrapper.properties # Often kept, but can be ignored if only specific to local setup
# Keystore files (sensitive)
*.jks
*.keystore

# iOS specific
/ios/build/
/ios/.symlinks/
/ios/.generated/
/ios/Flutter/.last_build_id # Already included above, but good to be explicit
/ios/.flutter-plugins
/ios/.flutter-plugins-dependencies
/ios/.xcode.env.local # Local Xcode environment variables
/ios/*.xcarchive/
/ios/*.ipa
/ios/*.app
/ios/Pods/
/ios/Runner/*.xcworkspace/xcuserdata/ # User-specific workspace data
/ios/Runner.xcworkspace/
/ios/Runner.xcodeproj/project.xcworkspace/
/ios/Runner.xcodeproj/xcuserdata/ # User-specific project data
/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Web specific
/web/
# If you run `flutter build web`, the output goes into `build/web`, which is already ignored by `/build/`

# macOS specific
/macos/build/
/macos/.generated/
/macos/.symlinks/
/macos/*.app
/macos/*.xcarchive/
/macos/*.ipa
/macos/Pods/
/macos/Runner/*.xcworkspace/xcuserdata/
/macos/Runner.xcworkspace/
/macos/Runner.xcodeproj/project.xcworkspace/
/macos/Runner.xcodeproj/xcuserdata/
/macos/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Windows specific
/windows/build/
/windows/x64/ # Common output directory
/windows/x86/
/windows/out/
/windows/*.exe
/windows/*.dll
/windows/*.pdb # Program Database files

# Linux specific
/linux/build/
/linux/bundle/ # Common output directory
/linux/lib/
/linux/bin/

# ====================================================================
# END OF .gitignore
# ====================================================================