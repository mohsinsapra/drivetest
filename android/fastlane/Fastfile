default_platform(:android)

platform :android do
  desc "Deploy Beta"
  lane :beta do
    play_store_json_key = resolve_play_store_json_key

    previous_build_number = google_play_track_version_codes(
      track: "alpha",
      json_key_data: play_store_json_key
    ).max

    current_build_number = previous_build_number + 1
    puts "Current build number: #{current_build_number}"

    # Get changelog from CHANGELOG.md for this version
    changelog_text = get_latest_changelog_entry

    changelogs_dir = "metadata/android/en-US/changelogs"
    FileUtils.mkdir_p(changelogs_dir)

    # Write the changelog for Google Play
    changelog_path = "metadata/android/en-US/changelogs/#{current_build_number}.txt"
    File.write(changelog_path, changelog_text)

    # Use Flutter CLI to build — works on both local and CI without local.properties setup
    # FLUTTER_DART_DEFINES is set by CI; locally this falls back to .env values.
    dart_defines = resolve_flutter_dart_defines
    sh("cd .. && flutter build appbundle --release --build-number=#{current_build_number} #{dart_defines}")

    upload_to_play_store(
      track: "alpha",
      skip_upload_metadata: true,
      skip_upload_images: true,
      version_code: current_build_number,
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: play_store_json_key
    )

    # Tag the release
    tag_release(build_number: current_build_number)
  end

  desc "Build, upload to alpha, then promote to production"
  lane :deploy do
    beta
    production
  end

  desc "Promote alpha to production"
  lane :production do
    upload_to_play_store(
      track: 'alpha',
      track_promote_to: 'production',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key_data: resolve_play_store_json_key
    )
  end

  desc "promote from internal to alpha"
  lane :promote_internal_to_alpha do
  promote_to_track(
    from_track: 'internal',
    track: 'alpha',
    rollout: 1.0
  )
end

  # Helper methods
  private_lane :update_local_properties_version do |options|
    build_number = options[:build_number] || options
    local_properties_path = "../local.properties"

    if File.exist?(local_properties_path)
      content = File.read(local_properties_path)

      # Update flutter.versionCode
      updated_content = content.gsub(
        /^flutter\.versionCode=.*/,
        "flutter.versionCode=#{build_number}"
      )

      File.write(local_properties_path, updated_content)
      puts "📦 Updated local.properties versionCode to: #{build_number}"
    else
      puts "⚠️  local.properties not found at #{File.expand_path(local_properties_path)}!"
    end
  end

  private_lane :update_flutter_version do
    # Read current version from pubspec.yaml
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    current_version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if current_version_match
      version = current_version_match[1]
      build = current_version_match[2].to_i

      # Increment build number
      new_build = build + 1

      # Update pubspec.yaml
      updated_content = pubspec_content.gsub(
        /^version:\s*.+/,
        "version: #{version}+#{new_build}"
      )
      File.write(pubspec_path, updated_content)

      puts "📦 Updated version: #{version}+#{new_build}"
    end
  end

  private_lane :get_latest_changelog_entry do
    changelog_path = "../../CHANGELOG.md"
    changelog_text = ""

    if File.exist?(changelog_path)
      changelog_content = File.read(changelog_path)

      # Extract the latest version entry (after Unreleased section)
      # Match from first version heading to next version heading or end
      match = changelog_content.match(/## \[\d+\.\d+\.\d+\+\d+\].*?\n\n(.*?)(?=\n---|\z)/m)

      if match
        # Clean up the changelog text for Google Play (remove markdown formatting)
        changelog_text = match[1]
          .gsub(/^### /, '')  # Remove heading markers
          .gsub(/^- /, '• ')  # Convert markdown lists to bullets
          .strip

        # Limit to 500 characters for Google Play
        if changelog_text.length > 500
          changelog_text = changelog_text[0...497] + "..."
        end
      end
    end

    # Fallback to generic message if changelog is empty
    if changelog_text.empty?
      changelog_text = "Bug fixes and improvements."
    end

    changelog_text
  end

  private_lane :resolve_play_store_json_key do
    return ENV["PLAY_STORE_JSON_KEY"] unless ENV["PLAY_STORE_JSON_KEY"].to_s.strip.empty?

    env_vars = load_root_env
    json_key_path = env_vars["PLAY_STORE_JSON_KEY_PATH"].to_s.strip

    UI.user_error!("Missing PLAY_STORE_JSON_KEY or PLAY_STORE_JSON_KEY_PATH") if json_key_path.empty?
    UI.user_error!("PLAY_STORE_JSON_KEY_PATH not found: #{json_key_path}") unless File.exist?(json_key_path)

    File.read(json_key_path)
  end

  private_lane :resolve_flutter_dart_defines do
    explicit_defines = ENV["FLUTTER_DART_DEFINES"].to_s.strip
    return explicit_defines unless explicit_defines.empty?

    env_vars = load_root_env
    google_server_client_id = env_vars["GOOGLE_SERVER_CLIENT_ID"].to_s.strip
    stripe_publishable_key = env_vars["STRIPE_PUBLISHABLE_KEY"].to_s.strip

    defines = []
    defines << "--dart-define=GOOGLE_SERVER_CLIENT_ID=#{google_server_client_id}" unless google_server_client_id.empty?
    defines << "--dart-define=STRIPE_PUBLISHABLE_KEY=#{stripe_publishable_key}" unless stripe_publishable_key.empty?

    defines.join(" ")
  end

  private_lane :load_root_env do
    env_path = File.expand_path("../../.env", __dir__)
    return {} unless File.exist?(env_path)

    File.readlines(env_path).each_with_object({}) do |line, vars|
      next if line.strip.empty? || line.lstrip.start_with?("#")

      key, value = line.split("=", 2)
      next if key.nil? || value.nil?

      vars[key.strip] = value.strip
    end
  end

  private_lane :tag_release do |options|
    pubspec_path = "../../pubspec.yaml"
    pubspec_content = File.read(pubspec_path)

    version_match = pubspec_content.match(/^version:\s*(.+)\+(\d+)/)
    if version_match
      build_number = options[:build_number] || version_match[2]
      version_tag = "v#{version_match[1]}-#{build_number}"

      begin
        sh("git tag #{version_tag}")
        puts "✅ Created tag: #{version_tag}"
        puts "   Push it with: git push origin #{version_tag}"
      rescue => e
        puts "⚠️  Failed to create tag (may already exist): #{e.message}"
      end
    end
  end

end
